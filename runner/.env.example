# POKER GOAT 솔버 러너 설정. 이 파일을 `.env`로 복사해 값 채우기.
# ⚠️ .env는 git 제외(커밋 금지). 셸이 아니라 러너가 KEY=VALUE로 읽는다.
#
#   cp .env.example .env  &&  chmod 600 .env  &&  값 입력
#
# 프로세스 환경에 이미 있는 키는 이 파일이 덮어쓰지 않는다.
# 그래서 `SOLVER_ONCE=1 ./runner.py` 같은 일회성 지정이 그대로 먹는다.

# ── API ────────────────────────────────────────────────────────────────
# 잡 큐를 가진 Django API 루트. 로컬 테스트는 http://localhost:8010
SOLVER_API_BASE=https://api.pokergoat.xyz

# 러너 공유 토큰. Django의 settings.SOLVER_RUNNER_TOKEN과 같은 값이어야 하고,
# 비어 있으면 러너 엔드포인트가 503을 준다. 긴 랜덤 문자열로 만든다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SOLVER_RUNNER_TOKEN=

# 누가 잡았는지 추적하는 식별자. 비우면 호스트명. [A-Za-z0-9._-] 64자 이내.
SOLVER_RUNNER_ID=

# ── 솔버 바이너리 ───────────────────────────────────────────────────────
# 기본값은 runner/bin/pokergoat-solver (install-bin.sh가 여기에 푼다).
SOLVER_BIN=

# rayon 스레드 수. 비우면 코어 수 (애플 실리콘은 물리 코어와 같다).
SOLVER_THREADS=

# estimate가 이 값을 넘는 메모리를 요구하면 솔브하지 않고 실패로 보고한다.
# 맥 램에서 OS와 다른 앱 몫을 뺀 값으로 잡는다 (36GB 맥이면 24 정도).
SOLVER_MAX_MEMORY_GB=24

# 잡 하나의 solve 시간 상한(초). CLI의 --time-limit으로 그대로 넘어간다.
SOLVER_JOB_TIME_LIMIT_SEC=3600

# 잡별 작업 디렉토리. 기본 runner/work (완료하면 지운다).
SOLVER_WORK_DIR=

# 큐가 비었을 때 다시 두드리기까지 쉬는 시간(초).
SOLVER_POLL_INTERVAL_SEC=30

# 1이면 잡 하나만 처리하고 종료. 테스트용이라 launchd 운영에서는 비워둔다.
SOLVER_ONCE=

# ── Cloudflare R2 ──────────────────────────────────────────────────────
# 계정 id는 Cloudflare 대시보드 R2 화면 우측 또는 S3 API 엔드포인트 주소에서
# 확인한다. 엔드포인트는 https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com.
R2_ACCOUNT_ID=

# R2 API 토큰의 Access Key ID / Secret Access Key.
# 권한은 대상 버킷의 Object Read & Write면 충분하다.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# blob을 올릴 버킷. Django의 SOLVER_R2_BUCKET과 같은 값이어야 커스텀 솔브의
# presigned URL이 같은 파일을 가리킨다.
R2_BUCKET=pokergoat-solver
